{
  "name": "ipynb2web",
  "description": "Prepare and convert Jupyter Notebooks into HTML templating content.",
  "keywords": [
    "jupyter",
    "notebook",
    "html",
    "template",
    "templating",
    "ipynb",
    "convert",
    "prepare"
  ],
  "tags": [
    "jupyter",
    "notebook",
    "html",
    "template",
    "templating",
    "ipynb",
    "convert",
    "prepare"
  ],
  "author": "Charles Karpati",
  "license": "MIT",
  "type": "module",
  "version": "1.0.42",
  "main": "dist/ipynb2web.cjs",
  "browser": "dist/ipynb2web.browser.umd.js",
  "module": "./src/node.js",
  "exports": {
    "import": {
      "default": "./src/node.js"
    },
    "require": {
      "default": "./dist/ipynb2web.cjs"
    }
  },
  "repository": "https://github.com/karpatic/ipynb2web.git",
  "homepage": "https://ipynb2web.com/",
  "bin": {
    "ipynb2web": "./bin/ipynb2web.cli.min.cjs"
  },
  "files": [
    "bin/",
    "dist/",
    "src/"
  ],
  "scripts": {
    "build": "webpack --config webpack.config.cjs",
    "docs": "npm run build && npm run builddocs && npm run builddocu",
    "publish:npm": "npm publish --access public",
    "buildesm": "node esbuild.js",
    "testcli": "node ./bin/ipynb2web.cli.cjs audio",
    "testnodecommon": "node ./test/test_node_common.cjs",
    "testnodemodule": "node ./test/test_node_module.mjs",
    "testbrowsermodule": "node ./test/test_browser_module.js",
    "testbrowser": "node ./test/test_browser.js",
    "testnode": "npm run testcli ; npm run testnodecommon ; npm run testnodemodule",
    "builddocs": "jsdoc -c jsdoc.conf.json",
    "watchdocs": "nodemon --watch src --watch template --ext js,mjs,cjs,tmpl,css --exec \"npm run builddocs\"",
    "watchdocu": "cd docusaurus; npm run start",
    "sync:readme-doc": "cp README.md docusaurus/docs/overview/getting-started.md",
    "builddocu": "npm run sync:readme-doc && cp dist/ipynb2web.browser.min.mjs docusaurus/static/ipynb2web.browser.mjs && cp dist/ipynb2web.browser.min.mjs.LICENSE.txt docusaurus/static/ && rm -rf ./docs/* && cd docusaurus && npx docusaurus build --out-dir build-local && cp -r build-local/* ../docs/ && rm -rf build-local && cp CNAME ../docs/",
    "publish:github": "./scripts/publish-github-package.sh",
    "publish:all": "npm run publish:npm && npm run publish:github",
    "release": "npm version patch && npm run publish:all",
    "test": "node test/test_node_module.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@babel/preset-env": "^7.23.8",
    "babel-loader": "^9.1.3",
    "esbuild": "^0.25.10",
    "jsdoc": "^4.0.2",
    "webpack-cli": "^4.10.0",
    "webpack-node-externals": "^3.0.0"
  },
  "dependencies": {
    "docusaurus": "^0.0.2",
    "fs": "^0.0.1-security",
    "http-server": "^14.1.1",
    "markdown-it": "^14.3.1",
    "markdown-it-footnote": "^4.0.0",
    "nodemon": "^3.1.7",
    "path": "^0.12.7",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
